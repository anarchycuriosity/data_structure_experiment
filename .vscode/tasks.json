{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ensure Bin Directory",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/bin"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build Active File",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++20",
                "-Wall",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe"
            ],
            "windows": {
                "command": "C:/Program Files/mingw64/bin/g++.exe"
            },
            "dependsOn": [
                "Ensure Bin Directory"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
