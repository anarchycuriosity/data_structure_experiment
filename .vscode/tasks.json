{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Active File",
            "type": "shell",
            "command": "g++",
            "args": [
                "${file}",
                "-o",
                "${workspaceFolder}/bin/${fileBasenameNoExtension}",
                "-I",
                "${workspaceFolder}/inc/",
                "-std=c++20",
                "-Wall",
                "-g"
            ],
            "windows": {
                "args": [
                    "${file}",
                    "-o",
                    "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe",
                    "-I",
                    "${workspaceFolder}/inc/",
                    "-std=c++20",
                    "-Wall",
                    "-g"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
